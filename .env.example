# PostgreSQL
# Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Public read-only Demo: ID in the database configured by DATABASE_URL.
# Server-side publication scope; empty disables /demo. Never use NEXT_PUBLIC_.
DEMO_WORKSPACE_ID=""

# Required for a Public Demo deployment: set to "true" at build AND runtime.
# Unset/empty/"false" runs normal SaaS; other non-empty values fail closed.
PUBLIC_DEMO_MODE=""

# Inngest: disabled in Public Demo mode; no Inngest keys or runtime indexing required.
# Normal SaaS with Inngest Cloud requires signing/event keys (server-only secrets).
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""
# Rotation only: previous signing key during a coordinated rollout.
INNGEST_SIGNING_KEY_FALLBACK=""
# Optional Cloud environment/branch selection; isolate Preview from Production.
INNGEST_ENV=""
# Local development only. Production must use cloud mode; false/0 are safe.
# Remove dev settings from the build/start process without editing local secrets.
INNGEST_DEV=""
# Supported SDK sync policy. Production also enforces signed sync in serve options.
# Use Cloud UI/API/integration sync instead of an unsigned direct PUT.
INNGEST_ENABLE_UNAUTHED_SYNC="false"
# INNGEST_BASE_URL / INNGEST_API_BASE_URL / INNGEST_EVENT_API_BASE_URL:
# optional SDK endpoint overrides. Custom/self-hosted endpoints are allowed when
# the SDK remains in cloud mode; production rejects resolved Inngest dev mode.

# Auth.js
# Generate a secure random value for local/production environments.
AUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Generative AI
GOOGLE_GENERATIVE_AI_API_KEY=""

# Groq AI (evaluation only)
GROQ_API_KEY=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry runtime: public event-ingestion DSN, embedded in the client at build time.
# Also used by the server and edge SDKs. Empty disables event delivery.
NEXT_PUBLIC_SENTRY_DSN=""

# Sentry build only: source map upload destination and secret auth token.
# Set these in the build/CI environment; never expose the token via NEXT_PUBLIC_.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Sentry performance tracing sample rate: 0 disables tracing, 1 traces every request.
# Recommended production baseline: 0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"


