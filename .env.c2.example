# Copy to .env.c2.local (ignored by Git); never copy development secrets.
# Fixed Compose identity: evidence-atlas-c2 / postgres-c2.
# Fixed database/user: evidence_atlas_c2 / c2_local.
# Fixed host binding: 127.0.0.1:5433 -> PostgreSQL 5432.
C2_MODE=local

# Required, unique local password. No committed default.
# Use a long random alphanumeric password to avoid Compose interpolation issues.
C2_POSTGRES_PASSWORD=

# Supply the complete URL yourself; this file does not expand variables.
# Shape: postgresql://c2_local:<URL-encoded-C2-password>@127.0.0.1:5433/evidence_atlas_c2
# Password must match C2_POSTGRES_PASSWORD after URL decoding.
C2_DATABASE_URL=

# Docker: explicitly pass --env-file .env.c2.local -f compose.c2.yml -p evidence-atlas-c2.
# Prisma: use scripts/c2-db.ts; it explicitly reads this file, validates the
# target, and supplies DATABASE_URL to the child. No normal .env fallback.
# Next.js does NOT load this filename automatically. App setup belongs to Step 2.
