// use prisma-next

// ============================================================
// User & Organization
// ============================================================

model User {
  id       String  @id @default(cuid(2))
  email    String  @unique
  username String?
  name     String?

  memberships         Membership[]
  workspaceMemberships WorkspaceMembership[]
  researches          Research[]
  comments            Comment[]

  @@map("user")
}

model Organization {
  id   String @id @default(cuid(2))
  name String

  memberships Membership[]
  workspaces  Workspace[]

  @@map("organization")
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

model Membership {
  userId         String
  organizationId String
  role           OrganizationRole

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@id([userId, organizationId])
  @@map("membership")
}


// ============================================================
// Workspace
// ============================================================

model Workspace {
  id             String @id @default(cuid(2))
  organizationId String

  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  organization Organization @relation(
    fields: [organizationId],
    references: [id]
  )

  memberships WorkspaceMembership[]
  researches  Research[]
  tags        Tag[]

  @@map("workspace")
}

enum WorkspaceRole {
  ADMIN
  MEMBER
}

model WorkspaceMembership {
  userId      String
  workspaceId String
  role        WorkspaceRole

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@id([userId, workspaceId])

  @@map("workspaceMembership")
}


// ============================================================
// Research
// ============================================================

enum ResearchStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Research {
  id            String @id @default(cuid(2))
  workspaceId   String
  createdById   String

  title       String
  description String?
  status      ResearchStatus @default(IN_PROGRESS)
  conclusion  String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  workspace Workspace @relation(
    fields: [workspaceId],
    references: [id]
  )

  createdBy User @relation(
    fields: [createdById],
    references: [id]
  )

  sources  Source[]
  findings Finding[]
  comments Comment[]
  tags     ResearchTag[]
  conversations Conversation[]

  @@map("research")
}

model Conversation {
  id         String @id @default(cuid(2))
  researchId String

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  research Research @relation(
    fields: [researchId],
    references: [id],
    onDelete: Cascade
  )

  messages Message[]

  @@map("conversation")
}

// ============================================================
// Source
// ============================================================

model Source {
  id         String @id @default(cuid(2))
  researchId String

  title String
  url   String

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  research Research @relation(
    fields: [researchId],
    references: [id]
  )

  findings FindingSource[]

  @@map("source")
}


// ============================================================
// Finding
// ============================================================

enum FindingDisplayStyle {
  TEXT
}

model Finding {
  id           String @id @default(cuid(2))
  researchId   String

  content      String
  data         Json?
  displayStyle FindingDisplayStyle @default(TEXT)

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  research Research @relation(
    fields: [researchId],
    references: [id]
  )

  sources FindingSource[]

  @@map("finding")
}

model FindingSource {
  findingId String
  sourceId  String

  finding Finding @relation(
    fields: [findingId],
    references: [id],
    onDelete: Cascade
  )

  source Source @relation(
    fields: [sourceId],
    references: [id],
    onDelete: Cascade
  )

  @@id([findingId, sourceId])

  @@map("findingSource")
}


// ============================================================
// Comment
// ============================================================

model Comment {
  id         String @id @default(cuid(2))
  researchId String
  userId     String

  content String

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  research Research @relation(
    fields: [researchId],
    references: [id]
  )

  user User @relation(
    fields: [userId],
    references: [id]
  )

  @@map("comment")
}


// ============================================================
// Tag
// ============================================================

model Tag {
  id          String @id @default(cuid(2))
  workspaceId String

  name String

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  workspace  Workspace     @relation(
    fields: [workspaceId],
    references: [id]
  )

  researches ResearchTag[]

  @@unique([workspaceId, name])

  @@map("tag")
}

model ResearchTag {
  researchId String
  tagId      String

  research Research @relation(
    fields: [researchId],
    references: [id]
  )

  tag Tag @relation(
    fields: [tagId],
    references: [id]
  )

  @@id([researchId, tagId])

  @@map("researchTag")
}


// ============================================================
// Conversation
// ============================================================



enum MessageAuthorType {
  USER
  AI
}

model Message {
  id             String @id @default(cuid(2))
  conversationId String

  authorType MessageAuthorType
  content    String

  createdAt DateTime @default(now())

  conversation Conversation @relation(
    fields: [conversationId],
    references: [id]
  )

  @@map("message")
}

// ============================================================
// Pgvector
// ============================================================

types {
  Embedding768 = pgvector.Vector(768)
}

enum RetrievalSourceType {
  FINDING
  CONCLUSION
  RESEARCH
}

model RetrievalChunk {
  id          String              @id @default(uuid())
  workspaceId String
  researchId  String
  sourceType  RetrievalSourceType
  sourceId    String
  chunkIndex  Int
  content     String
  embedding   Embedding768
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([workspaceId])
  @@index([researchId])
  @@map("retrievalChunk")
}
