# Copy to .env.c2.auth.local (Git-ignored). Do not copy ordinary .env.local.
# Dedicated random session secret, at least 32 characters. No default.
AUTH_SECRET=
# Separately reviewed Google Web OAuth client credentials. No defaults.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only these three keys are allowed. The launcher sets AUTH_URL itself:
# http://localhost:3001 (callback: /api/auth/callback/google).
# B1/B2 offline implementation does not authorize startup/login.
